# Copy to .env and fill in. NEVER commit .env.

# ---- Gemini ----
GEMINI_API_KEY=our_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite       # verify this is a currently available model for your key
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2                 # retries after the first attempt (429/5xx/timeouts only)

# ---- HTTP / security ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173   # comma-separated; empty disables CORS
MAX_UPLOAD_MB=10
REQUEST_TIMEOUT_SECONDS=120
RATE_LIMIT_PER_MINUTE=60             # per client IP, in-memory, single process; 0 disables
LOG_LEVEL=INFO

# ---- PDF / OCR ----
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_MAX_PAGES=15                     # max pages OCR'd per scanned PDF
PDF_MAX_PAGES=300

# ---- RAG ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PRELOAD_EMBEDDING_MODEL=false        # true = load at startup instead of on first request
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4

# ---- Question generation / evaluation ----
MAX_QUESTIONS=50
EVAL_MAX_BATCH_SIZE=25
EVAL_CONFIDENCE_THRESHOLD=0.6        # below this, an evaluation is flagged for human review

# ---- Plagiarism screening ----
PLAGIARISM_MAX_FILES=10
PLAGIARISM_DOC_THRESHOLD=0.75
PLAGIARISM_SENTENCE_THRESHOLD=0.8
PLAGIARISM_MIN_MATCHING_SENTENCES=3
PLAGIARISM_SENTENCE_RATIO_THRESHOLD=0.3
PLAGIARISM_AI_MAX_PAIRS=3
